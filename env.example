# Copy to .env and fill in for your environment.
# .env is gitignored — never commit real values.

# --- Vehicle node (fleet-agent) ---

# Device node for the GPS board. Verify with `ls /dev/tty*` before and after
# plugging the board in — it may enumerate as ttyUSB0 or ttyACM0 depending on
# the USB-serial chip. Do not assume.
SERIAL_PORT=/dev/ttyUSB0

# Broker address. Use the broker host's real LAN address, not a Docker Compose
# service name — service names only resolve inside the Compose network, not
# from an external device.
MQTT_BROKER_URL=tcp://BROKER_HOST:1883

# Identity. Scopes MQTT topics and the dedupe key on the subscriber side.
DEVICE_ID=vehicle1

# SQLite store-and-forward buffer.
BUFFER_DB_PATH=/opt/fleet-agent/data/buffer.db


# --- Stationary node (same jar, different identity) ---
# DEVICE_ID=yard-sensor
# BUFFER_DB_PATH=/data/buffer.db
